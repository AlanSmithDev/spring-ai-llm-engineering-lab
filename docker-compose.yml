# 本地依赖：PGVector（向量库）+ Ollama（本地推理）
# 用法：make db-up / make db-down
services:
  postgres-pgvector:
    image: pgvector/pgvector:pg17
    container_name: spring-ai-pgvector
    environment:
      POSTGRES_USER: ${POSTGRES_USER:-postgres}
      POSTGRES_PASSWORD: ${POSTGRES_PASSWORD:-postgres}
      POSTGRES_DB: ${POSTGRES_DB:-spring_ai}
    ports:
      - "${POSTGRES_PORT:-5432}:5432"
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U ${POSTGRES_USER:-postgres} -d ${POSTGRES_DB:-spring_ai}"]
      interval: 5s
      timeout: 5s
      retries: 10
    volumes:
      - pgvector-data:/var/lib/postgresql/data

  ollama:
    image: ollama/ollama:latest
    container_name: spring-ai-ollama
    ports:
      - "${OLLAMA_PORT:-11434}:11434"
    volumes:
      - ollama-data:/root/.ollama
    deploy:
      resources:
        reservations:
          devices:
            - driver: nvidia
              count: 1
              capabilities: [gpu]
    # 无 GPU 时删除上面的 deploy 段即可，Ollama 会自动用 CPU

volumes:
  pgvector-data:
  ollama-data:
